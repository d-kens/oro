---
import Layout from '../layouts/Layout.astro';
import { SKILLS } from '../data/skills.js';
import { href } from '../lib/site.js';
---
<Layout url="skills.html" title="Skills" description="Linux, networking and shell scripting, taught topic by topic with hands-on tasks, quizzes and projects.">
<main class="skills">
<header>
  <h1>Skills</h1>
  <p>Pick a skill and work through its topics in order. Each topic has hands-on tasks and a short quiz, and every skill ends with projects.</p>
</header>
<ul class="skill-list">
  {SKILLS.map((s) => (
    <li>
      <a href={href(`skills/${s.slug}.html`)}>{s.name}</a>
      <p>{s.summary}</p>
      <span class="facts">{s.level} · {s.topics.length} topics{s.projects.length > 0 && ` · ${s.projects.length} projects`}</span>
    </li>
  ))}
</ul>
</main>
</Layout>
