---
/* every lab on the roadmap, in order. A lab whose topic has notes links to the lab's section in those notes. */
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { MODULES } from '../data/curriculum.js';
import { href, pad } from '../lib/site.js';

const labs = await Promise.all(MODULES.filter((m) => m.kind).map(async (m) => {
  if (m.status !== 'published') return { m, link: null };
  /* the notes' h2 whose heading mentions "Lab", or the top of the notes if there is none */
  const { headings } = await render(await getEntry('notes', m.slug));
  const lab = headings.find((h) => h.depth === 2 && /\blab\b/i.test(h.text));
  return { m, link: href(`notes/${m.slug}.html${lab ? '#' + lab.slug : ''}`) };
}));
---
<Layout url="labs.html" title="Labs" description="Every hands-on lab on the Paipa DevOps roadmap, in order: one app taken from a commit to a secured, monitored deployment.">
<main class="labs">
<header>
  <h1>Labs</h1>
  <p>{labs.length} hands-on labs, in the order they come up. They build on each other, so one app goes from a commit to a secured, monitored deployment.</p>
</header>
<ol class="lab-list">
  {labs.map(({ m, link }, i) => (
    <li class:list={{ live: link }}>
      <span class="n">{pad(i + 1)}</span>
      <div>
        <p class="task">{link ? <a href={link}>{m.task}</a> : m.task}</p>
        <p class="topic">{m.kind === 'Project' ? 'Final project' : m.title}{!link && <span> · not written yet</span>}</p>
      </div>
    </li>
  ))}
</ol>
</main>
</Layout>
