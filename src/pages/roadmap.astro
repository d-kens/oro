---
/* the roadmap: the skills for a role, in order. Written skills link to their page; the rest are planned. */
import Layout from '../layouts/Layout.astro';
import { ROADMAPS } from '../data/roadmaps.js';
import { SKILLS } from '../data/skills.js';
import { href, pad } from '../lib/site.js';

const skill = (slug) => SKILLS.find((s) => s.slug === slug);
---
<Layout url="roadmap.html" title="Roadmaps" description="The DevOps engineer roadmap: the skills to learn, in order.">
<main class="roadmap">
<header>
  <h1>Roadmaps</h1>
  <p>The skills for a role, in the order to learn them. Linked skills are written; the rest are planned.</p>
</header>
{ROADMAPS.map((r) => (
  <section class="path" id={r.slug}>
    <h2>{r.name}</h2>
    <p>{r.summary}</p>
    <ol>
      {r.steps.map(([slug, name], i) => {
        const s = skill(slug);
        return (
          <li class:list={{ live: s }}>
            <span class="n">{pad(i + 1)}</span>
            {s ? <a href={href(`skills/${s.slug}.html`)}>{s.name}</a> : <span>{name}</span>}
            <span class="facts">{s ? `${s.topics.length} topics` + (s.projects.length ? ` · ${s.projects.length} projects` : '') : 'Planned'}</span>
          </li>
        );
      })}
    </ol>
  </section>
))}
</main>
</Layout>
