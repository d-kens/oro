---
/* a topic's notes page, one per published topic: the notes, with a sticky contents list beside them on wide screens */
import { getEntry, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { PHASES, MODULES } from '../../data/curriculum.js';
import { href, niceDate, published } from '../../lib/site.js';

export const getStaticPaths = () => published.map((m) => ({ params: { slug: m.slug }, props: { m } }));

const { m } = Astro.props;
const ph = PHASES[m.phase];
const entry = await getEntry('notes', m.slug);
const { Content, headings } = await render(entry);
const sections = headings.filter((h) => h.depth === 2);
/* about 220 words a minute, counting the words in the Markdown (code included, as it gets read too) */
const minutes = Math.max(1, Math.round(entry.body.split(/\s+/).filter(Boolean).length / 220));
const neighbours = [[-1, 'Previous'], [1, 'Next']].map(([step, label]) => ({ x: MODULES[m.num - 1 + step], label }));
---
<Layout url={`notes/${m.slug}.html`} title={m.title} ogType="article" scripts={['notes.js']}
  description={`${m.name}: ${m.summary}`}>
<div class="progress-line" aria-hidden="true"></div>
<main class:list={['notes', { 'has-toc': sections.length >= 3 }]}>
<header class="notes-head">
  <p class="crumbs"><a href={href('roadmap.html')}>Roadmap</a><span aria-hidden="true">/</span><a href={href(`roadmap.html#phase-${m.phase}`)}>{ph.name}</a></p>
  <h1>{m.title}</h1>
  {m.summary && <p class="lead">{m.summary}</p>}
  <p class="meta">{m.updated && <span>Updated {niceDate(m.updated)}</span>}<span>{minutes} min read</span></p>
</header>
{sections.length >= 3 && (
  <nav class="toc" aria-label="On this page"><details open><summary>On this page</summary><ul>
    {sections.map((s) => <li><a href={`#${s.slug}`}>{s.text}</a></li>)}
  </ul></details></nav>
)}
<div class="notes-body">
<article class="md"><Content /></article>
{m.kind && <aside class="your-turn"><p class="label">{m.kind}</p><p>{m.task}</p></aside>}
<nav class="pn" aria-label="Topics">
  {neighbours.map(({ x, label }) => {
    if (!x) return <span></span>;
    const inner = <><span class="label">{label}</span><b>{x.title}</b></>;
    return x.status === 'published'
      ? <a href={href(`notes/${x.slug}.html`)}>{inner}</a>
      : <div class="soon">{inner}<span class="label">Not written yet</span></div>;
  })}
</nav>
</div>
</main>
</Layout>
