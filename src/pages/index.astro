---
/* the home page: what Oro is and where to start, the skills ready now, and how the lessons work */
import Layout from '../layouts/Layout.astro';
import JoinCta from '../components/JoinCta.astro';
import { ROADMAPS } from '../data/roadmaps.js';
import { SKILLS } from '../data/skills.js';
import { href } from '../lib/site.js';

const first = ROADMAPS[0].steps.map(([slug]) => SKILLS.find((s) => s.slug === slug)).find(Boolean);
/* cloud and the foundations first; What is DevOps last, so the page does not read as DevOps only */
const shown = [...SKILLS].sort((a, b) => (a.slug === 'what-is-devops') - (b.slug === 'what-is-devops'));
/* the three newest skills, newest first */
const newest = [...SKILLS].sort((a, b) => b.added.localeCompare(a.added)).slice(0, 3);
const day = (iso) => new Date(iso + 'T00:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
---
<Layout description="The skills cloud engineers use every day, taught one step at a time, with clear notes and labs that run on your own computer.">
<main class="home">
<header class="hero">
  <h1>Learn cloud and DevOps.</h1>
  <p class="lead">The skills cloud engineers use every day, taught one step at a time, with clear notes and labs that run on your own computer.</p>
  <p class="actions">
    <a class="btn" href={href(`skills/${first.slug}.html`)}>Start learning</a>
    <a class="btn outline" href={href('roadmap.html')}>See the roadmaps</a>
  </p>
</header>

<section class="skills" aria-labelledby="skills-head">
  <h2 id="skills-head">Skills</h2>
  <p>{SKILLS.length} skills are written so far. Each one works on its own or as a step of a roadmap.</p>
  <div class="cols">
    {shown.map((s) => (
      <div>
        <h3>{s.name}</h3>
        <p>{s.summary}</p>
        <span class="facts">{s.level} · {s.topics.length} topics{s.projects.length > 0 && ` · ${s.projects.length} projects`}</span>
        <a class="link" href={href(`skills/${s.slug}.html`)}>See the lessons<span class="sr"> in {s.name}</span></a>
      </div>
    ))}
  </div>
</section>

<section class="split" aria-labelledby="how-head">
  <div>
    <h2 id="how-head">How you learn</h2>
    <p>Every skill works the same way.</p>
  </div>
  <ol class="steps">
    <li><span class="n" aria-hidden="true">1</span><h3>Read</h3><p>Each lesson explains what a tool does, why it exists and how to use it, in plain words.</p></li>
    <li><span class="n" aria-hidden="true">2</span><h3>Practise</h3><p>Every lesson ends with tasks to try and a short quiz, with the answers to check your work.</p></li>
    <li><span class="n" aria-hidden="true">3</span><h3>Build</h3><p>Each skill ends with projects that put its lessons together, like setting up a machine or writing a deploy script.</p></li>
  </ol>
</section>

<section class="new" aria-labelledby="new-head">
  <h2 id="new-head">Newly added</h2>
  <p>The latest skills to go up on Oro.</p>
  <ol class="new-list">
    {newest.map((s) => (
      <li>
        <time datetime={s.added}>{day(s.added)}</time>
        <div><h3>{s.name}</h3><p>{s.summary}</p></div>
        <a class="link" href={href(`skills/${s.slug}.html`)}>See the lessons<span class="sr"> in {s.name}</span></a>
      </li>
    ))}
  </ol>
</section>

<JoinCta />
</main>
</Layout>
