---
/* every project from every skill, grouped by skill in the skills' order; projects.js turns the skill links into a filter */
import { getEntry } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import JoinCta from '../components/JoinCta.astro';
import { SKILLS } from '../data/skills.js';
import { href, lessons, minutes } from '../lib/site.js';

const groups = await Promise.all(SKILLS.map(async (s) => ({ s, projects: await Promise.all(lessons.filter((l) => l.skill === s && l.project)
  .map(async (l) => ({ ...l, min: minutes((await getEntry('lessons', `${s.slug}/${l.slug}`)).body) }))) })))
  .then((gs) => gs.filter((g) => g.projects.length));
const total = groups.reduce((n, g) => n + g.projects.length, 0);
---
<Layout url="projects.html" title="Projects" description="Hands-on projects for every skill. Each one runs on your own computer, with no cloud account needed." scripts={['projects.js']}>
<main class="home">
<header class="page-hero">
  <h1>Projects</h1>
  <p class="lead">{total} hands-on projects, grouped by skill. Each one runs on your own computer, with no cloud account needed.</p>
  <nav class="jump" aria-label="Show projects for">
    {groups.map(({ s, projects }) => <a href={`?skill=${s.slug}`} data-skill={s.slug}>{s.name}<span>{projects.length}</span></a>)}
  </nav>
</header>

{groups.map(({ s, projects }) => (
  <section class="proj-group" id={s.slug} aria-labelledby={`${s.slug}-head`}>
    <div class="proj-head">
      <h2 id={`${s.slug}-head`}>{s.name}</h2>
      <p>Do the <a href={href(`skills/${s.slug}.html`)}>{s.name} lessons</a> first, then these projects.</p>
    </div>
    <div class="proj-grid">
      {projects.map((l, i) => (
        <article class="proj">
          <p class="meta">Project {i + 1} · {l.min} min read</p>
          <h3>{l.title}</h3>
          <p>{l.line}</p>
          <a class="link" href={href(l.url)}>Open the project<span class="sr">: {l.title}</span></a>
        </article>
      ))}
    </div>
  </section>
))}

<JoinCta title="Built something?" text="Share it in the Oro community on WhatsApp, ask for feedback, and see what others are building." />
</main>
</Layout>
