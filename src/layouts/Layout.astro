---
/* The shared layout: every page has the same head, nav and scripts.
   url: the page's path on the live site, for canonical links. scripts: files in public/ to load after nav.js.
   crumbs: [name, path] pairs from the top down, given to search engines as a breadcrumb trail. */
import { SITE, NAME, WHATSAPP, href } from '../lib/site.js';
import { SKILLS } from '../data/skills.js';

const { title: pageTitle, description, url = '', ogType = 'website', noindex = false, scripts = [], crumbs = [] } = Astro.props;
const title = pageTitle ? pageTitle + ' · ' + NAME : NAME + ' · Learn cloud and DevOps';
/* the nav links; the current page's link is marked, the site's root counts as Home, and a skill's page counts as part of Skills. */
const here = Astro.url.pathname;
const links = [['index.html', 'Home'], ['roadmap.html', 'Roadmaps'], ['skills.html', 'Skills'], ['projects.html', 'Projects'], ['about.html', 'About']]
  .map(([path, label]) => ({ path, label, current: here.endsWith('/' + path) || (path === 'index.html' && here === href()) || (path === 'skills.html' && here.includes('/skills/')) }));
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
{description && <meta name="description" content={description}>}
<meta name="theme-color" content="#f6f7f9">
<link rel="icon" href={href('favicon.svg')} type="image/svg+xml">
{noindex ? <meta name="robots" content="noindex"> : <>
<link rel="canonical" href={`${SITE}/${url}`}>
<meta property="og:type" content={ogType}>
<meta property="og:site_name" content={NAME}>
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={`${SITE}/${url}`}>
<meta property="og:image" content={`${SITE}/og-image.png`}>
<meta name="twitter:card" content="summary_large_image">
</>}
{crumbs.length > 0 && <script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: crumbs.map(([name, path], i) => ({ '@type': 'ListItem', position: i + 1, name, item: `${SITE}/${path}` }))
})} />}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400..600&family=Hanken+Grotesk:wght@400;500;700&family=IBM+Plex+Mono:wght@300;400;500&display=swap">
<link rel="stylesheet" href={href('styles.css')}>
<script is:inline>document.documentElement.classList.add('js');</script>
</head>
<body>

<div class="wrap" id="top">
  <nav aria-label="Site">
    <a class="logo" href={href('index.html')}><img src={href('logo.svg')} alt="" width="28" height="28">oro</a>
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-links" aria-label="Open menu"><span></span></button>
    <ul id="site-links">
      {links.map((l, i) => <li><a href={href(l.path)} aria-current={l.current ? 'page' : undefined}><span class="n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>{l.label}</a></li>)}
      <li class="search-link"><a href={href('search.html')} aria-current={here.endsWith('/search.html') ? 'page' : undefined} aria-keyshortcuts="/"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4.5 4.5"/></svg>Search<kbd aria-hidden="true">/</kbd></a></li>
      <li class="join"><a href={WHATSAPP} target="_blank" rel="noopener">{/* the WhatsApp speech bubble, drawn in line */}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 19.5 5.6 16A8 8 0 1 1 8.4 18.6Z"/><path d="M9.2 9.3c.3 2.3 2.2 4.4 4.9 5.2l1.2-1.2-1.6-.8-.7.7c-1-.4-1.9-1.3-2.4-2.4l.7-.7-.8-1.6Z" class="fill"/></svg>Join the community<span class="sr">on WhatsApp (opens in a new tab)</span></a></li>
    </ul>
  </nav>
  <slot />
  <footer class="site-foot">
    <div class="foot-in">
      <div class="foot-about">
        <a class="logo" href={href('index.html')}><img src={href('logo-white.svg')} alt="" width="28" height="28">oro</a>
        <p class="tagline">Learn cloud and DevOps.</p>
        <p>One skill at a time, with notes and labs that run on your own computer.</p>
      </div>
      <div><h2>Learn</h2><ul>
        <li><a href={href('roadmap.html')}>Roadmaps</a></li>
        <li><a href={href('skills.html')}>Skills</a></li>
        <li><a href={href('projects.html')}>Projects</a></li>
        <li><a href={href('search.html')}>Search</a></li>
      </ul></div>
      <div><h2>Skills</h2><ul>
        {SKILLS.map((s) => <li><a href={href(`skills/${s.slug}.html`)}>{s.name}</a></li>)}
      </ul></div>
      <div><h2>Oro</h2><ul>
        <li><a href={href('about.html')}>About</a></li>
        <li><a href={WHATSAPP} target="_blank" rel="noopener">WhatsApp group</a></li>
      </ul></div>
      <div class="foot-bottom">
        <p>© {new Date().getFullYear()} Oro. Lessons and brand all rights reserved; site code under the MIT licence.</p>
        <a href="#top">Back to top</a>
      </div>
    </div>
  </footer>
</div>
<script is:inline src={href('nav.js')}></script>
{scripts.map((s) => <script is:inline src={href(s)}></script>)}
</body>
</html>
